<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FindMyMoney.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dashboard="clr-namespace:FindMyMoney.Presentations.Dashboard"
    xmlns:emis="clr-namespace:FindMyMoney.Presentations.Emis"
    Title="FindMyMoney">

    <TabBar>
        <ShellContent
            Title="Dashboard"
            Icon="home.png"
            ContentTemplate="{DataTemplate dashboard:DashboardPage}"
            Route="Dashboard" />

        <ShellContent
            Title="EMIs"
            Icon="home.png"
            ContentTemplate="{DataTemplate emis:EmisPage}"
            Route="Emis" />
    </TabBar>

</Shell>
