<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FindMyMoney.Presentations.Emis.AddEmiPage"
             xmlns:viewmodel="clr-namespace:FindMyMoney.Presentations.Emis"
             x:DataType="viewmodel:AddEmiViewModel"
             Title="Add EMI / Loan"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Add EMI / Loan"
                           FontSize="24" FontAttributes="Bold" TextColor="#9C27B0" />
                    <Label Text="Track your loan repayments"
                           FontSize="14" TextColor="{StaticResource Gray600}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Loan Details -->
            <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20">
                <VerticalStackLayout Spacing="18">

                    <Label Text="Loan Details" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />

                    <!-- Loan Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Loan Name *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="#9C27B0" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding LoanName}" Placeholder="e.g. Home Loan, Car Loan"
                                   FontSize="16" BackgroundColor="Transparent" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Bank Name -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Bank / Lender *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding BankName}" Placeholder="e.g. HDFC Bank, SBI"
                                   FontSize="16" BackgroundColor="Transparent" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Total Loan Amount -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Total Loan Amount *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="₹" FontSize="16" TextColor="#9C27B0"
                                       VerticalOptions="Center" Margin="0,0,6,0" />
                                <Entry Grid.Column="1" Text="{Binding TotalAmount}" Placeholder="0.00"
                                       Keyboard="Numeric" FontSize="16" BackgroundColor="Transparent"
                                       TextColor="{StaticResource Gray900}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- EMI Amount -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Monthly EMI *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="₹" FontSize="16" TextColor="#9C27B0"
                                       VerticalOptions="Center" Margin="0,0,6,0" />
                                <Entry Grid.Column="1" Text="{Binding EmiAmount}" Placeholder="0.00"
                                       Keyboard="Numeric" FontSize="16" BackgroundColor="Transparent"
                                       TextColor="{StaticResource Gray900}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Total EMIs and Paid EMIs -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Total EMIs *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                    Padding="12,8" StrokeShape="RoundRectangle 8">
                                <Entry Text="{Binding TotalEmis}" Placeholder="e.g. 60"
                                       Keyboard="Numeric" FontSize="16" BackgroundColor="Transparent"
                                       TextColor="{StaticResource Gray900}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Paid EMIs" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                            <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                    Padding="12,8" StrokeShape="RoundRectangle 8">
                                <Entry Text="{Binding PaidEmis}" Placeholder="0"
                                       Keyboard="Numeric" FontSize="16" BackgroundColor="Transparent"
                                       TextColor="{StaticResource Gray900}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Interest Rate -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Interest Rate (% per annum)" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding InterestRate}" Placeholder="e.g. 8.5"
                                   Keyboard="Numeric" FontSize="16" BackgroundColor="Transparent"
                                   TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Dates -->
            <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20">
                <VerticalStackLayout Spacing="18">

                    <Label Text="Schedule" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />

                    <!-- Start Date -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Loan Start Date" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <DatePicker Date="{Binding StartDate}" Format="MMMM dd, yyyy"
                                        FontSize="16" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Next Due Date -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Next Due Date" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="#9C27B0" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <DatePicker Date="{Binding NextDueDate}" Format="MMMM dd, yyyy"
                                        FontSize="16" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Status -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Status" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,0" StrokeShape="RoundRectangle 8">
                            <Picker ItemsSource="{Binding StatusOptions}"
                                    SelectedItem="{Binding SelectedStatus}"
                                    FontSize="16" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Description -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Notes" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <Editor Text="{Binding Description}" Placeholder="Additional notes..."
                                    FontSize="16" HeightRequest="80" AutoSize="TextChanges"
                                    BackgroundColor="Transparent" TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error -->
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                           TextColor="Red" FontSize="14" HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>

            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Cancel"
                        BackgroundColor="{StaticResource Gray300}" TextColor="{StaticResource Gray900}"
                        Command="{Binding CancelCommand}" CornerRadius="10" HeightRequest="50" />
                <Button Grid.Column="1" Text="Save EMI"
                        BackgroundColor="#9C27B0" TextColor="White"
                        Command="{Binding SaveEmiCommand}" IsEnabled="{Binding IsFormValid}"
                        CornerRadius="10" HeightRequest="50" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="#9C27B0" HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
