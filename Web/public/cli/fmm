#!/usr/bin/env python3
"""fmm — FindMyMoney from the terminal (like gh for GitHub).

Talks to the FindMyMoney API with your own login, so the app's rules apply
(a spend on a credit card is stored as a card spend, etc.).

  fmm login                         sign in (token kept 7 days in ~/.config/fmm)
  fmm cards                         list cards and accounts
  fmm spends sbi --from 2026-10-03  list spends on a card
  fmm add sbi 2004 Shopping "Amazon Pay" --date 2026-10-24
  fmm import sbi spends.csv         preview a CSV import (add --yes to save)
  fmm pay sbi 20000 --from hdfc     record a card payment made from a bank account
  fmm bills [card]                  list card bills
  fmm bill-paid sbi 2026-10 --from hdfc
  fmm statement sbi                 estimate the next statement
  fmm update                        get the latest version

Install: curl -fsSL https://findmymoney.pnjb.in/cli/install.sh | sh

Run `fmm <command> -h` for options.
"""
import argparse
import base64
import calendar
import csv
import getpass
import json
import os
import re
import sys
import urllib.error
import urllib.request
from datetime import date, datetime, timedelta
from decimal import Decimal

VERSION = "1.1.0"
UPDATE_URL = "https://findmymoney.pnjb.in/cli/fmm"
DEFAULT_API = "https://pnjbdetnetdevwin-bwfweggteaefh7au.centralindia-01.azurewebsites.net"
CONFIG = os.path.expanduser("~/.config/fmm/config.json")
CARD_BILL = "Credit Card Bill"


# ── config + HTTP ──────────────────────────────────────────────────────────────

def load_config():
    try:
        with open(CONFIG) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def save_config(cfg):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    fd = os.open(CONFIG, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(cfg, f, indent=2)


def die(msg):
    print(f"fmm: {msg}", file=sys.stderr)
    sys.exit(1)


def api(method, path, body=None, auth=True):
    cfg = load_config()
    base = os.environ.get("FMM_API") or cfg.get("base_url") or DEFAULT_API
    headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if auth:
        if not cfg.get("token"):
            die("not logged in — run `fmm login`")
        headers["Authorization"] = f"Bearer {cfg['token']}"
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(base + "/api/findmymoney" + path, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read().decode()
    except urllib.error.HTTPError as e:
        if e.code == 401:
            die("session expired or invalid — run `fmm login`")
        die(f"{method} {path} failed: HTTP {e.code} {e.read().decode()[:300]}")
    except urllib.error.URLError as e:
        die(f"cannot reach the API: {e.reason}")
    if not raw:
        return None
    parsed = json.loads(raw)
    # Some endpoints wrap results as { data, hasErrors, message }.
    if isinstance(parsed, dict) and "data" in parsed and ("hasErrors" in parsed or "message" in parsed):
        return parsed["data"]
    return parsed


# ── helpers ───────────────────────────────────────────────────────────────────

def money(x):
    """Indian grouping, like CRED and the bank apps: ₹1,23,324.52."""
    v = Decimal(str(x)).quantize(Decimal("0.01"))
    whole, frac = f"{abs(v):.2f}".split(".")
    head, tail = whole[:-3], whole[-3:]
    while len(head) > 2:
        tail, head = f"{head[-2:]},{tail}", head[:-2]
    grouped = f"{head},{tail}" if head else tail
    return f"{'−' if v < 0 else ''}₹{grouped}.{frac}"


def day(s):
    return datetime.strptime(s, "%Y-%m-%d").date()


def as_date(iso):
    return date.fromisoformat(iso[:10])


def cards():
    return api("GET", "/paymentsources") or []


def find_card(name, sources=None, prefer="CreditCard"):
    """Match by last 4 digits or part of the name. On a tie (e.g. 'sbi' = SBI bank + SBI Prime card)
    the `prefer` type wins: credit cards for card commands, banks for --from."""
    sources = sources or cards()
    key = name.lower()
    hits = [s for s in sources if (s.get("accountLast4") or "") == name] or \
           [s for s in sources if key in s["name"].lower()]
    if len(hits) > 1:
        hits = [s for s in hits if s["type"] == prefer] or hits
    if len(hits) > 1:
        hits = [s for s in hits if s["name"].lower() == key] or hits
    if not hits:
        die(f"no card or account matches '{name}' — see `fmm cards`")
    if len(hits) > 1:
        die(f"'{name}' matches several: " + ", ".join(s["name"] for s in hits))
    return hits[0]


def expenses_between(start, end):
    """All expenses dated start..end (inclusive), fetched month by month."""
    out, y, m = [], start.year, start.month
    while (y, m) <= (end.year, end.month):
        out += api("GET", f"/expenses?year={y}&month={m}") or []
        y, m = (y + 1, 1) if m == 12 else (y, m + 1)
    return [e for e in out if start <= as_date(e["date"]) <= end]


def is_dup(row_date, amount, existing):
    return any(as_date(e["date"]) == row_date and abs(Decimal(str(e["amount"])) - amount) <= 1 for e in existing)


def create_expense(card_id, amount, category, desc, when):
    return api("POST", "/expenses", {
        "amount": float(amount), "category": category, "description": desc,
        "date": f"{when.isoformat()}T00:00:00", "paymentSourceId": card_id,
    })


def last_statement_date(cycle_day, today):
    def on(y, m):
        return date(y, m, min(cycle_day, calendar.monthrange(y, m)[1]))
    d = on(today.year, today.month)
    if d > today:
        y, m = (today.year - 1, 12) if today.month == 1 else (today.year, today.month - 1)
        d = on(y, m)
    return d


def table(rows, cols):
    widths = [max(len(str(r[i])) for r in rows + [cols]) for i in range(len(cols))]
    print("  ".join(str(c).ljust(w) for c, w in zip(cols, widths)))
    for r in rows:
        print("  ".join(str(v).ljust(w) for v, w in zip(r, widths)))


# ── commands ──────────────────────────────────────────────────────────────────

def cmd_login(a):
    cfg = load_config()
    if a.api:
        cfg["base_url"] = a.api.rstrip("/")
        save_config(cfg)
    if a.token:
        token, who = a.token.strip(), "(token)"
    else:
        user = a.username or input("Username: ")
        res = api("POST", "/auth/login", {"username": user, "password": getpass.getpass("Password: ")}, auth=False)
        token, who = res["token"], res.get("username", user)
    cfg = load_config()
    cfg.update(token=token, username=who)
    save_config(cfg)
    me = api("GET", "/auth/me")
    print(f"Logged in as {me.get('username', who)} — token saved to {CONFIG}")


def cmd_whoami(_):
    cfg = load_config()
    if not cfg.get("token"):
        die("not logged in")
    payload = cfg["token"].split(".")[1]
    claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
    exp = datetime.fromtimestamp(claims.get("exp", 0))
    print(f"{cfg.get('username')} — token valid until {exp:%d %b %Y %H:%M}")


def cmd_cards(_):
    rows = [(s["name"], s["type"], s.get("accountLast4") or "", s.get("billingCycleDay") or "",
             s.get("dueDaysAfterBilling") or "", "" if s.get("isActive", True) else "inactive") for s in cards()]
    table(rows, ("NAME", "TYPE", "LAST4", "BILL DAY", "DUE DAYS", ""))


def cmd_spends(a):
    card = find_card(a.card)
    end = day(a.to) if a.to else date.today()
    start = day(a.frm) if a.frm else end - timedelta(days=30)
    rows = sorted((e for e in expenses_between(start, end) if e.get("paymentSourceId") == card["id"]),
                  key=lambda e: e["date"])
    table([(e["date"][:10], money(e["amount"]), e["category"], e.get("description") or "") for e in rows],
          ("DATE", "AMOUNT", "CATEGORY", "DESCRIPTION"))
    print(f"\n{len(rows)} spends on {card['name']}, {start:%d %b} – {end:%d %b %Y}: "
          f"{money(sum(Decimal(str(e['amount'])) for e in rows))}")


def cmd_add(a):
    card = find_card(a.card)
    when = day(a.date) if a.date else date.today()
    amount = Decimal(a.amount)
    if not a.force and is_dup(when, amount, [e for e in expenses_between(when, when)
                                             if e.get("paymentSourceId") == card["id"]]):
        die(f"{money(amount)} on {when} is already on {card['name']} — use --force to add anyway")
    create_expense(card["id"], amount, a.category, a.description, when)
    print(f"Added {money(amount)} {a.category} '{a.description}' on {when:%d %b %Y} to {card['name']}")


def cmd_import(a):
    """CSV columns: date (YYYY-MM-DD), amount, category, description. Skips rows already on the card."""
    card = find_card(a.card)
    with open(a.file, newline="") as f:
        rows = [(day(r["date"].strip()), Decimal(r["amount"].strip()), r["category"].strip(),
                 (r.get("description") or "").strip()) for r in csv.DictReader(f)]
    if not rows:
        die("no rows in file")
    existing = [e for e in expenses_between(min(r[0] for r in rows), max(r[0] for r in rows))
                if e.get("paymentSourceId") == card["id"]]
    new, skipped = [], []
    for r in rows:
        # One-to-one: each spend already in the app can cover only one CSV row, so genuine same-day repeats survive.
        hit = next((e for e in existing if as_date(e["date"]) == r[0]
                    and abs(Decimal(str(e["amount"])) - r[1]) <= 1), None)
        if hit:
            existing.remove(hit)
            skipped.append(r)
        else:
            new.append(r)
    print(f"{card['name']}: {len(new)} new ({money(sum(r[1] for r in new))}), {len(skipped)} already there")
    for r in new:
        print(f"  + {r[0]}  {money(r[1]):>12}  {r[2]:<18} {r[3]}")
    for r in skipped:
        print(f"  = {r[0]}  {money(r[1]):>12}  (skipped, already in app)")
    if not a.yes:
        print("\nPreview only — run again with --yes to save.")
        return
    for r in new:
        create_expense(card["id"], r[1], r[2], r[3], r[0])
    print(f"Saved {len(new)} spends.")


def cmd_pay(a):
    card = find_card(a.card)
    src = find_card(a.frm, prefer="Bank") if a.frm else None
    when = day(a.date) if a.date else date.today()
    create_expense(src["id"] if src else None, Decimal(a.amount), CARD_BILL, f"{card['name']} payment", when)
    print(f"Recorded {money(a.amount)} paid to {card['name']} on {when:%d %b %Y}"
          + (f" from {src['name']}" if src else ""))


def cmd_bills(a):
    sources = cards()
    q = f"?paymentSourceId={find_card(a.card, sources)['id']}" if a.card else ""
    bills = sorted(api("GET", f"/creditcardbills{q}") or [], key=lambda b: (b["billingYear"], b["billingMonth"]))
    table([(b["paymentSourceName"], f"{b['billingYear']}-{b['billingMonth']:02d}", money(b["totalAmount"]),
            b["dueDate"][:10], b["status"], (b.get("paidAt") or "")[:10]) for b in bills],
          ("CARD", "MONTH", "AMOUNT", "DUE", "STATUS", "PAID ON"))


def cmd_bill_paid(a):
    sources = cards()
    card = find_card(a.card, sources)
    y, m = (int(x) for x in a.month.split("-"))
    bill = next((b for b in api("GET", f"/creditcardbills?paymentSourceId={card['id']}") or []
                 if b["billingYear"] == y and b["billingMonth"] == m), None)
    if not bill:
        die(f"no {a.month} bill for {card['name']} — see `fmm bills {a.card}`")
    src = find_card(a.frm, sources, prefer="Bank") if a.frm else None
    api("PUT", f"/creditcardbills/{bill['id']}/pay", {"paidFromSourceId": src["id"] if src else None})
    print(f"Marked {card['name']} {a.month} bill ({money(bill['totalAmount'])}) as paid")


def cmd_statement(a):
    """Next statement ≈ unpaid previous bill − payments since + spends since + EMI installments."""
    sources = cards()
    card = find_card(a.card, sources)
    if not card.get("billingCycleDay"):
        die(f"{card['name']} has no billing day set")
    today = date.today()
    last = last_statement_date(card["billingCycleDay"], today)
    nxt = last_statement_date(card["billingCycleDay"], last + timedelta(days=40))
    window = expenses_between(last - timedelta(days=1), today)
    on_card = [e for e in window if e.get("paymentSourceId") == card["id"]]
    spends = sum(Decimal(str(e["amount"])) for e in on_card if as_date(e["date"]) > last)
    # Installments post on statement day; assume the same amounts as last time.
    emi = sum(Decimal(str(e["amount"])) for e in on_card
              if as_date(e["date"]) == last and (e["category"] == "EMI" or e["category"] == CARD_BILL))
    # Payments to this card: `fmm pay` rows ("<card> payment") and app mark-paid rows ("<card> bill — MM/YYYY").
    paid = sum(Decimal(str(e["amount"])) for e in window
               if e["category"] == CARD_BILL and as_date(e["date"]) > last
               and e.get("paymentSourceId") != card["id"]
               and (e.get("description") or "").startswith(card["name"]))
    paid += Decimal(a.paid or 0)
    bills = api("GET", f"/creditcardbills?paymentSourceId={card['id']}") or []
    prev = next((b for b in bills if (b["billingYear"], b["billingMonth"]) == (last.year, last.month)), None)
    carry = Decimal(str(prev["totalAmount"])) if prev else Decimal(0)
    total = carry - paid + spends + emi
    print(f"{card['name']} — next statement on {nxt:%d %b %Y} (last was {last:%d %b})")
    if prev:
        print(f"  Last statement           {money(carry):>14}   ({prev['status'].lower()})")
    else:
        print(f"  (no bill saved for {last:%b %Y} — add it in the app for an exact figure)")
    print(f"  Spends since {last:%d %b}       {money(spends):>14}")
    print(f"  EMI installments (est.)  {money(emi):>14}   same as on {last:%d %b}")
    if paid:
        print(f"  Payments since {last:%d %b}     {money(-paid):>14}")
    print(f"  Estimated statement      {money(total):>14}")
    if card.get("creditLimit"):
        print(f"  Credit limit             {money(card['creditLimit']):>14}")


def cmd_update(a):
    try:
        with urllib.request.urlopen(UPDATE_URL, timeout=30) as resp:
            new = resp.read()
    except urllib.error.URLError as e:
        die(f"cannot download {UPDATE_URL}: {e}")
    m = re.search(rb'^VERSION = "([0-9.]+)"', new, re.M)
    if not (new.startswith(b"#!/usr/bin/env python3") and m):
        die("download doesn't look like fmm — not updating")
    latest = m.group(1).decode()
    as_tuple = lambda v: tuple(int(x) for x in v.split("."))
    if as_tuple(latest) <= as_tuple(VERSION) and not a.force:
        print(f"fmm {VERSION} is the latest")
        return
    target = os.path.realpath(__file__)
    tmp = target + ".new"
    try:
        with open(tmp, "wb") as f:
            f.write(new)
        os.chmod(tmp, 0o755)
        os.replace(tmp, target)
    except PermissionError:
        die(f"no permission to write {target} — try: sudo fmm update")
    print(f"Updated fmm {VERSION} → {latest}")


def main():
    p = argparse.ArgumentParser(prog="fmm", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"fmm {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("login", help="sign in")
    s.add_argument("-u", "--username")
    s.add_argument("--token", help="use a token instead of username/password (e.g. Google sign-in users)")
    s.add_argument("--api", help="API base URL (default: production)")
    s.set_defaults(fn=cmd_login)

    sub.add_parser("whoami", help="show login and token expiry").set_defaults(fn=cmd_whoami)
    sub.add_parser("cards", help="list cards and accounts").set_defaults(fn=cmd_cards)

    s = sub.add_parser("spends", help="list spends on a card")
    s.add_argument("card")
    s.add_argument("--from", dest="frm", help="YYYY-MM-DD (default: 30 days ago)")
    s.add_argument("--to", help="YYYY-MM-DD (default: today)")
    s.set_defaults(fn=cmd_spends)

    s = sub.add_parser("add", help="add one spend")
    s.add_argument("card", help="card/account name or last 4 digits, e.g. sbi, 6704, cash")
    s.add_argument("amount")
    s.add_argument("category", help='e.g. "Food / Outsite", Shopping, "Travel / Petrol"')
    s.add_argument("description")
    s.add_argument("--date", help="YYYY-MM-DD (default: today)")
    s.add_argument("--force", action="store_true", help="add even if the same amount is already there that day")
    s.set_defaults(fn=cmd_add)

    s = sub.add_parser("import", help="import spends from a CSV (date,amount,category,description)")
    s.add_argument("card")
    s.add_argument("file")
    s.add_argument("--yes", action="store_true", help="save (without it, only a preview is shown)")
    s.set_defaults(fn=cmd_import)

    s = sub.add_parser("pay", help="record a payment made to a card")
    s.add_argument("card")
    s.add_argument("amount")
    s.add_argument("--from", dest="frm", help="bank account it was paid from")
    s.add_argument("--date", help="YYYY-MM-DD (default: today)")
    s.set_defaults(fn=cmd_pay)

    s = sub.add_parser("bills", help="list card bills")
    s.add_argument("card", nargs="?")
    s.set_defaults(fn=cmd_bills)

    s = sub.add_parser("bill-paid", help="mark a card bill as paid")
    s.add_argument("card")
    s.add_argument("month", help="bill month, YYYY-MM")
    s.add_argument("--from", dest="frm", help="bank account it was paid from (records the payment as money out)")
    s.set_defaults(fn=cmd_bill_paid)

    s = sub.add_parser("statement", help="estimate the next statement for a card")
    s.add_argument("card")
    s.add_argument("--paid", help="extra payments not recorded in the app yet")
    s.set_defaults(fn=cmd_statement)

    s = sub.add_parser("update", help="download the latest fmm")
    s.add_argument("--force", action="store_true", help="reinstall even if already on the latest version")
    s.set_defaults(fn=cmd_update)

    a = p.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
