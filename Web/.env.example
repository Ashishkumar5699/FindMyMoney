# Copy to .env.local for local development
DOTNET_BASE_URL=https://pnjbdetnetdevwin-bwfweggteaefh7au.centralindia-01.azurewebsites.net
# The .NET API's Tokenkey (64+ bytes). Required: the web app won't start without it.
DOTNET_JWT_SECRET=
# Optional, during a key rotation: the previous Tokenkey, so tokens signed with it keep working until they expire
DOTNET_JWT_SECRET_PREVIOUS=

# Google OAuth (next-auth)
AUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
