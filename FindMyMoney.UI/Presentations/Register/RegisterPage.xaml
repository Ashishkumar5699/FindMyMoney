<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FindMyMoney.UI.Presentations.Register.RegisterPage"
             xmlns:viewmodel="clr-namespace:FindMyMoney.UI.Presentations.Register"
             x:DataType="viewmodel:RegisterViewModel"
             Title="Register"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">

            <!-- Header -->
            <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Create Account"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" />
                    <Label Text="Start tracking your finances"
                           FontSize="14"
                           TextColor="{StaticResource Gray600}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Form -->
            <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Padding="20">
                <VerticalStackLayout Spacing="18">

                    <!-- Username -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Username *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Primary}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding Username}"
                                   Placeholder="Choose a username"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding Email}"
                                   Placeholder="your@email.com"
                                   Keyboard="Email"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding Password}"
                                   Placeholder="Minimum 6 characters"
                                   IsPassword="True"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Confirm Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirm Password *" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Gray900}" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1" BackgroundColor="White"
                                Padding="12,8" StrokeShape="RoundRectangle 8">
                            <Entry Text="{Binding ConfirmPassword}"
                                   Placeholder="Re-enter your password"
                                   IsPassword="True"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   TextColor="{StaticResource Gray900}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error Message -->
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                           TextColor="Red"
                           FontSize="14"
                           HorizontalOptions="Center" />

                    <!-- Success Message -->
                    <Label Text="{Binding SuccessMessage}"
                           IsVisible="{Binding SuccessMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}"
                           TextColor="#4CAF50"
                           FontSize="14"
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>

            <!-- Register Button — disabled while request is in flight -->
            <Button Text="Create Account"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Command="{Binding RegisterCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                    CornerRadius="10"
                    HeightRequest="52"
                    FontSize="18"
                    FontAttributes="Bold" />

            <!-- Back to Login -->
            <Button Text="Already have an account? Login"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Command="{Binding GoToLoginCommand}"
                    FontSize="14"
                    HorizontalOptions="Center" />

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
