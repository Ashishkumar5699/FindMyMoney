<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FindMyMoney.Presentations.Login.LoginPage"
             xmlns:viewmodel="clr-namespace:FindMyMoney.UI.Presentations.Login"
             xmlns:converters="clr-namespace:FindMyMoney.UI.Converters"
             x:DataType="viewmodel:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#1A237E">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringIsNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0" VerticalOptions="Fill">

            <!-- Hero Header -->
            <VerticalStackLayout BackgroundColor="#1A237E" Padding="30,60,30,40" Spacing="12">
                <Frame BackgroundColor="#FFFFFF"
                       CornerRadius="28"
                       Padding="16"
                       WidthRequest="80"
                       HeightRequest="80"
                       HasShadow="False"
                       HorizontalOptions="Center">
                    <Label Text="₹"
                           FontSize="40"
                           FontAttributes="Bold"
                           TextColor="#1A237E"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Frame>

                <Label Text="FindMyMoney"
                       FontSize="30"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                <Label Text="Track · Save · Grow"
                       FontSize="14"
                       TextColor="#90CAF9"
                       HorizontalOptions="Center"
                       CharacterSpacing="2" />
            </VerticalStackLayout>

            <!-- Login Card -->
            <Frame BackgroundColor="White"
                   CornerRadius="30"
                   HasShadow="True"
                   Padding="28,32"
                   Margin="0,-20,0,0">
                <VerticalStackLayout Spacing="20">

                    <Label Text="Welcome Back"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#1A237E"
                           HorizontalOptions="Center" />

                    <Label Text="Sign in to your account"
                           FontSize="14"
                           TextColor="{StaticResource Gray500}"
                           HorizontalOptions="Center"
                           Margin="0,-10,0,0" />

                    <!-- Username -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Username" FontSize="13" FontAttributes="Bold" TextColor="#37474F" />
                        <Border Stroke="#1A237E" StrokeThickness="1.5"
                                BackgroundColor="#F5F7FF"
                                Padding="14,12"
                                StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="👤" FontSize="16" VerticalOptions="Center" Margin="0,0,8,0" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Username}"
                                       Placeholder="Enter your username"
                                       PlaceholderColor="{StaticResource Gray400}"
                                       FontSize="15"
                                       BackgroundColor="Transparent"
                                       TextColor="#1A237E" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password" FontSize="13" FontAttributes="Bold" TextColor="#37474F" />
                        <Border Stroke="{StaticResource Gray300}" StrokeThickness="1.5"
                                BackgroundColor="#F5F5F5"
                                Padding="14,12"
                                StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="🔒" FontSize="16" VerticalOptions="Center" Margin="0,0,8,0" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Password}"
                                       Placeholder="Enter your password"
                                       PlaceholderColor="#919191"
                                       IsPassword="True"
                                       FontSize="15"
                                       BackgroundColor="Transparent"
                                       TextColor="#37474F" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error Message -->
                    <Frame BackgroundColor="#FFEBEE"
                           CornerRadius="10"
                           Padding="12,8"
                           HasShadow="False"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringIsNotNullOrEmptyConverter}}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#C62828"
                               FontSize="13"
                               HorizontalOptions="Center" />
                    </Frame>

                    <!-- Login Button -->
                    <Button Text="Sign In"
                            BackgroundColor="#1A237E"
                            TextColor="White"
                            Command="{Binding LoginCommand}"
                            CornerRadius="14"
                            HeightRequest="54"
                            FontSize="17"
                            FontAttributes="Bold"
                            Margin="0,4,0,0" />

                    <!-- Loading -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#1A237E"
                                       HeightRequest="40" />

                    <!-- Divider -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,4">
                        <BoxView Grid.Column="0" HeightRequest="1" BackgroundColor="{StaticResource Gray200}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="OR" FontSize="12" TextColor="{StaticResource Gray400}" />
                        <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="{StaticResource Gray200}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Register Link -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Don't have an account?"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               HorizontalOptions="Center" />
                        <Button Text="Create Account →"
                                BackgroundColor="Transparent"
                                TextColor="#1A237E"
                                Command="{Binding GoToRegisterCommand}"
                                FontSize="15"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                Padding="0" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
